// Скопируйте этот файл в Secrets.xcconfig и подставьте свой ключ.
// Secrets.xcconfig в .gitignore и в репозиторий не попадает.
//
//   cp LingvanexAPI/LingvanexAPIDemo/Secrets.example.xcconfig \
//      LingvanexAPI/LingvanexAPIDemo/Secrets.xcconfig
//
// Ключ создаётся в личном кабинете: https://lingvanex.com/account

LINGVANEX_API_KEY = PUT_YOUR_KEY_HERE
