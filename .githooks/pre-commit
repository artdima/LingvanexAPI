#!/bin/sh
#
# Blocks commits that contain secrets.
# Enable once per clone: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks not found — secret scan skipped."
    echo "Install it: brew install gitleaks"
    exit 0
fi

gitleaks protect --staged --redact --config .gitleaks.toml
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "Commit blocked: a secret was found in the staged changes."
    echo "Remove it and stage again. Never commit API keys."
fi

exit $status
